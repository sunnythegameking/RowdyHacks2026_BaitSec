{
  "name": "BaitSec",
  "version": "1.0.0",
  "manifest_version": 3,
  "description": "Scans active tab URLs to detect malicious sites and brand impersonation clones.",
  "permissions": [
    "tabs",
    "storage",
    "notifications",
    "webNavigation"
  ],
  "host_permissions": [
    "https://safebrowsing.googleapis.com/*",
    "<all_urls>"
  ],
  "icons": {
    "16": "images/logo16.png",
    "32": "images/logo32.png",
    "48": "images/logo48.png",
    "128": "images/logo128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "images/logo16.png",
      "32": "images/logo32.png",
      "48": "images/logo48.png",
      "128": "images/logo128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}