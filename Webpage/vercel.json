{
  "version": 2,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.css", "use": "@vercel/static" },
    { "src": "images/**", "use": "@vercel/static" },
    { "src": "Video/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "^/images/(.*)$", "dest": "/images/$1" },
    { "src": "^/Video/(.*)$", "dest": "/Video/$1" },
    { "src": "^/$", "dest": "/BaitSec.html" },
    { "src": "^/BaitSec.html$", "dest": "/BaitSec.html" },
    { "src": "^/Education.html$", "dest": "/Education.html" }
  ]
}
