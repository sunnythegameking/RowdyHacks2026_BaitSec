{
  "name": "BaitSec",
  "version": "1.0.0",
  "manifest_version": 3,
  "description": "A browser extension that educates and protects against social engineering attacks.",
  "icons": {
    "16": "images/logo16.png",
    "32": "images/logo32.png",
    "48": "images/logo48.png",
    "128": "images/logo128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "images/logo16.png",
      "32": "images/logo32.png",
      "48": "images/logo48.png",
      "128": "images/logo128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
